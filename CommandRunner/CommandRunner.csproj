<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommandLib\CommandLib.csproj" />
  </ItemGroup>

  <!-- Копируем FileSystemCommands.dll в выходную папку -->
  <Target Name="CopyFileSystemCommandsDll" AfterTargets="Build">
    <ItemGroup>
      <FilesToCopy Include="..\FileSystemCommands\bin\$(Configuration)\$(TargetFramework)\FileSystemCommands.dll" />
      <FilesToCopy Include="..\FileSystemCommands\bin\$(Configuration)\$(TargetFramework)\CommandLib.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>